         /srv/lab/workspace/ml-labloop/deploy/quadlets/labloop-mcp-watchdog.service \
         /srv/lab/workspace/ml-labloop/deploy/quadlets/labloop-mcp-watchdog.timer \
         /home/mcp/.config/systemd/user/"
qga "su - mcp -c 'export XDG_RUNTIME_DIR=/run/user/\$(id -u); \
     systemctl --user daemon-reload && \
     systemctl --user enable --now labloop-mcp-watchdog.timer'"
