    -e "/^@MCP_PORTS_PUBLISH@\$/d" \
    -e "/^@MCP_ENTRYPOINT_VOLUME@\$/r $WORK/mcp-entrypoint.mount" \
    -e "/^@MCP_ENTRYPOINT_VOLUME@\$/d" \
