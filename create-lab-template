note "VSCodium + Zoo Code + vscode-pdf"
# cache path: pinned release .deb + local .vsix installs — the gitlab
# apt repo and open-vsx are never touched. The deb's dep closure is in
# the apt bundle (prefetch resolves it via --print-uris on the deb).
cod_deb=""; vsix_list=""
if [ "$CACHE_UP" = 1 ]; then
    cod_deb=$(basename "$(ls -t "$CACHE_ROOT"/pkgs/codium_*.deb 2>/dev/null | head -1)" 2>/dev/null || true)
    # A refreshed cache can retain older versions of the same extension.
    # Install exactly one version of each requested extension, highest
    # version first; do not let an old Zoo Code VSIX overwrite the latest.
    for extension in ZooCodeOrganization.zoo-code tomoki1207.pdf; do
        vsix=$(find "$CACHE_ROOT/pkgs" -maxdepth 1 -type f \
                    -name "$extension-*.vsix" -printf '%f\n' | sort -V | tail -n 1)
        [ -n "$vsix" ] || die "cache is missing required extension: $extension"
        vsix_list="$vsix_list $vsix"
    done
fi
if [ -n "$cod_deb" ]; then
    qga "curl -fsS -o '/tmp/$cod_deb' '$CACHE_URL/pkgs/$cod_deb' && \
         DEBIAN_FRONTEND=noninteractive apt-get install -y '/tmp/$cod_deb' && \
         rm -f '/tmp/$cod_deb'"
else
    qga "wget -qO - https://gitlab.com/paulcarroty/vscodium-deb-rpm-repo/raw/master/pub.gpg \
             | gpg --batch --yes --dearmor -o /usr/share/keyrings/vscodium-archive-keyring.gpg && \
         echo 'deb [signed-by=/usr/share/keyrings/vscodium-archive-keyring.gpg] https://download.vscodium.com/debs vscodium main' \
             > /etc/apt/sources.list.d/vscodium.list && \
         apt-get update -qq && apt-get install -y codium"
fi
if [ -n "$vsix_list" ]; then
    for v in $vsix_list; do
        # QGA downloads as root with restrictive umask; only lab needs
        # to read each VSIX, so grant ownership without world-read access.
        qga "set -eu; curl -fSL -o '/tmp/$v' '$CACHE_URL/pkgs/$v' && \
             chown lab:lab '/tmp/$v' && chmod 0600 '/tmp/$v'" \
            || die "failed to stage VSIX $v"
        qga_lab "codium --install-extension '/tmp/$v' && \
                 codium --list-extensions | grep -Fxi '${v%-*}'" \
            || die "failed to install/verify VSIX $v"
        qga "rm -f '/tmp/$v'" || die "failed to clean VSIX $v"
    done
else
    qga_lab "codium --install-extension ZooCodeOrganization.zoo-code && \
             codium --install-extension tomoki1207.pdf"
