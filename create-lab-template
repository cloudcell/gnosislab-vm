import re
p = '/home/lab/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml'
try:
    xml = open(p).read()
except FileNotFoundError:
    raise SystemExit(0)
for m in re.finditer(r'(<property name=\"plugin-\d+\" type=\"empty\">)(.*?)(</property>)', xml, re.S):
    if 'value=\"clock\"' not in m.group(2):
        continue
    blk = m.group(2).replace(
        '<property name=\"digital-time-format\" type=\"empty\"/>',
        '<property name=\"digital-time-format\" type=\"string\" value=\"%H:%M %Z\"/>')
    if 'name=\"timezone\"' not in blk:
