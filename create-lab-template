note "trial interpreter env: /srv/lab/trial-env -> /opt/trial-env (volume; survives recreates)"
# episteme's executor defaults to sys.executable — the slim server venv
# with NO scientific stack, which made warmup trials degrade to
# dependency-free rewrites. Populate a dedicated venv ONCE, on a
# quadlet-mounted volume: survives container recreates (the image layer
# would not), stays mcp-owned (lab/agent cannot tamper), and is
# updatable later with another `podman run` — no image rebuild needed.
# entrypoint.sh only exports ML_EPISTEME_EXECUTOR_PYTHON when the env
# exists, so an unpopulated dir degrades to the slim interpreter.
# wheels from the cache when available: the bundle is resolved inside
# python:3.12-slim at prefetch time so the tags match this interpreter.
# Resume without clearing an environment installed on a previous run.
# Validate from inside the trusted image, because venv Python symlinks
# resolve to container paths, not paths on the VM host.
trial_env_ready() {
    qga "su - mcp -c 'podman run --rm --pull=never --network=none \
        -e HOME=/tmp --entrypoint /opt/trial-env/bin/python \
        -v /srv/lab/trial-env:/opt/trial-env:ro lab-img-mcp \
        -c \"import numpy, pandas, scipy, sklearn, matplotlib, reportlab\"'" \
        >/dev/null 2>&1
}
if trial_env_ready; then
    echo "    existing scientific trial-env verified; reuse without modification"
else
    # An incomplete venv already has pyvenv.cfg. Install missing wheels
    # into it rather than recreating it (uv refuses overwrites).
    trial_env_exists=0
    if qga "test -f /srv/lab/trial-env/pyvenv.cfg" >/dev/null 2>&1; then
        trial_env_exists=1
    fi
if [ "$CACHE_UP" = 1 ] && compgen -G "$CACHE_ROOT/wheels/trial-env/*.whl" >/dev/null; then
    whl_list="$(ls "$CACHE_ROOT"/wheels/trial-env | tr '\n' ' ')"
    qga "install -d -m 0755 -o mcp -g mcp /srv/lab/trial-env /srv/lab/wheelhouse && \
         cd /srv/lab/wheelhouse && \
         for w in $whl_list; do curl -fsS -o \"\$w\" \"$CACHE_URL/wheels/trial-env/\$w\" || exit 1; done && \
         chown -R mcp:mcp /srv/lab/wheelhouse && \
         { [ $trial_env_exists = 1 ] || su - mcp -c 'podman run --rm -e HOME=/tmp --entrypoint uv \
             -v /srv/lab/trial-env:/opt/trial-env lab-img-mcp \
             venv /opt/trial-env'; } && \
