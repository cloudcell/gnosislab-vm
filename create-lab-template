             -v /srv/lab/trial-env:/opt/trial-env \
             -v /srv/lab/wheelhouse:/wheels lab-img-mcp \
             pip install --python /opt/trial-env/bin/python --no-cache \
             --no-index --find-links=/wheels \
             numpy pandas scipy scikit-learn matplotlib reportlab'"
else
    qga "install -d -m 0755 -o mcp -g mcp /srv/lab/trial-env && \
         { [ $trial_env_exists = 1 ] || su - mcp -c 'podman run --rm -e HOME=/tmp --entrypoint uv \
             -v /srv/lab/trial-env:/opt/trial-env lab-img-mcp \
