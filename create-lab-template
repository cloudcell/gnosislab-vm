# ports.env is pulled OUT of the loaded image (/opt/gnosislab on
# packaged images, /opt/ml-scientist on pre-switch ones) — publish
# rules and the watchdog's copy always match what the VM actually
# runs, whatever vintage the image is, and never drift from it.
PORTS_ENV_TXT=$(qga "su - mcp -c 'podman run --rm --entrypoint sh \
    lab-img-mcp -c \"cat /opt/*/ports.env\"'")
