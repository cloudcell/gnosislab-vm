note "images: load prefetched tarballs, else guest-side build"
# prefetch-cache.sh bakes both images host-side (registry pulls, debian
# apt, uv sync all execute in the online phase). Loading the tarballs
# into each user's rootless store gives the quadlets the same
# localhost/lab-img-* names the builds would produce.
img_mcp=""; img_exp=""
if [ "$CACHE_UP" = 1 ]; then
    img_mcp=$(basename "$(ls -t "$CACHE_ROOT"/images/lab-img-mcp-*.tar 2>/dev/null | head -1)" 2>/dev/null || true)
    img_exp=$(basename "$(ls -t "$CACHE_ROOT"/images/lab-img-exp-*.tar 2>/dev/null | head -1)" 2>/dev/null || true)
fi
# An imported image retains the config digest recorded by the Docker
# archive manifest. Compare that digest against both rootless stores,
# not merely the presence of a mutable :latest tag.
image_archive_config_id() {
    python3 - "$1" "$2" <<'PY_IMAGE_ID'
import json, re, sys, tarfile
with tarfile.open(sys.argv[1], "r") as archive:
    stream = archive.extractfile("manifest.json")
    if stream is None:
        raise SystemExit("missing image manifest")
    with stream:
        images = json.load(stream)
tag = f"localhost/lab-img-{sys.argv[2]}:latest"
if len(images) != 1 or tag not in images[0].get("RepoTags", []):
    raise SystemExit("cached archive has wrong image tag")
config = images[0]["Config"]
if not re.fullmatch(r"[a-f0-9]{64}\.json", config):
    raise SystemExit("unexpected config digest in archive")
print(config[:-5])
PY_IMAGE_ID
}
if [ -n "$img_mcp" ] && [ -n "$img_exp" ]; then
    expected_mcp=$(image_archive_config_id "$CACHE_ROOT/images/$img_mcp" mcp) \
        || die "cannot inspect cached MCP image identity"
    expected_exp=$(image_archive_config_id "$CACHE_ROOT/images/$img_exp" exp) \
        || die "cannot inspect cached experiment image identity"
    if qga "set -eu; \
         mcp_id=\$(su - mcp -c 'podman image inspect lab-img-mcp --format \"{{.Id}}\"'); \
         exp_id=\$(su - exp -c 'podman image inspect lab-img-exp --format \"{{.Id}}\"'); \
         { test \"\$mcp_id\" = 'sha256:$expected_mcp' || test \"\$mcp_id\" = '$expected_mcp'; } && \
         { test \"\$exp_id\" = 'sha256:$expected_exp' || test \"\$exp_id\" = '$expected_exp'; }" >/dev/null 2>&1; then
        echo "    cached image identities already match; skipping large downloads"
    else
        # Guest-agent commands run as root and create mode-0600 files with a
        # restrictive umask. Rootless Podman cannot load those from /tmp.
        # Stage under a root-owned, non-writable-to-users directory instead,
        # validate bytes against the verified host cache, then grant each
        # service account read access ONLY to its own archive.
        # Do not copy multi-GiB archives into both root and user home trees.
        mcp_sha=$(sha256sum "$CACHE_ROOT/images/$img_mcp" | cut -d' ' -f1)
        exp_sha=$(sha256sum "$CACHE_ROOT/images/$img_exp" | cut -d' ' -f1)
        import_dir=/var/cache/gnosislab/image-import
        qga "set -eu; \
             test ! -L /var/cache/gnosislab && test ! -L '$import_dir' && \
             install -d -m 0755 -o root -g root \
                 /var/cache/gnosislab '$import_dir' && \
             trap 'rm -f \"$import_dir/$img_mcp\" \"$import_dir/$img_exp\"' EXIT; \
             curl -fSL --retry 4 --retry-connrefused --connect-timeout 15 \
                 -o '$import_dir/$img_mcp' '$CACHE_URL/images/$img_mcp' && \
             printf '%s  %s\n' '$mcp_sha' '$import_dir/$img_mcp' | sha256sum -c - && \
             chown mcp:mcp '$import_dir/$img_mcp' && \
             chmod 0600 '$import_dir/$img_mcp' && \
             curl -fSL --retry 4 --retry-connrefused --connect-timeout 15 \
                 -o '$import_dir/$img_exp' '$CACHE_URL/images/$img_exp' && \
             printf '%s  %s\n' '$exp_sha' '$import_dir/$img_exp' | sha256sum -c - && \
             chown exp:exp '$import_dir/$img_exp' && \
             chmod 0600 '$import_dir/$img_exp' && \
             su - mcp -c 'podman load -i $import_dir/$img_mcp' && \
             su - exp -c 'podman load -i $import_dir/$img_exp' && \
             su - mcp -c 'podman image exists lab-img-mcp' && \
             su - exp -c 'podman image exists lab-img-exp'" \
            || die "cached OCI image import failed in $VM; check cache route, checksum and rootless Podman logs"
    fi
else
    qga "su - mcp -c 'podman build -t lab-img-mcp \
         --build-arg GNOSISLAB_VERSION=$GNOSISLAB_VER \
         --build-arg OFFLINE=$MCP_OFFLINE \
         -f /home/mcp/build/mcp/Containerfile /home/mcp/build/mcp'"
    qga "su - exp -c 'podman build -t lab-img-exp \
         /srv/lab/workspace/ml-labloop/containers/experiment'"
fi

