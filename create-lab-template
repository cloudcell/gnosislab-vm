#!/usr/bin/env bash
# create-lab-template — build the labloop golden VM image from scratch.
#
# Executable form of docs/sc-handbook/sc-01-labloop-setup-protocol.md.
# Produces a shut-off, snapshotted template that create-lab-user clones.
#
#   Usage:   ./create-lab-template [template-name]
#   Env:     LABLOOP_ISO    path to a Linux Mint ISO   (required if the
#                                                         domain does not exist)
#            GNOSISLAB_VER  gnosislab package pin for the trusted zone
#                           (default 0.1.42 — prefetch-cache.sh evals this line)
#            LABLOOP_PUBLISH=1  lock lab+exp passwords at freeze —
#                               mandatory before distributing the image
#
# One part cannot be automated without preseeding (Mint's live
# installer): the OS install itself. The script drives virt-install,
# then WAITS while you click through the installer and install
# qemu-guest-agent — everything after that is unattended, driven over
# the qemu guest-agent virtio channel (no ssh, no host TCP listeners).
#
# Ends with the guest shut down, XML hardened (clipboard off, virtio
# video at the configured native resolution), and an snp-vN snapshot.
#   sudo virt-sysprep -d <name>     # scrub identity
#   ./create-lab-user <user>        # per-user clone
set -euo pipefail

VM="${1:-lab-template-v1}"
case "$VM" in
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    -*|*[!a-zA-Z0-9_.-]*) echo "create-lab-template: bad domain name '$VM'" >&2; exit 1 ;;
esac
REPO="$(cd "$(dirname "$0")" && pwd)"
# gnosislab package pin — single source of truth for the trusted-zone
# version; prefetch-cache.sh evals this line. "latest" resolves to the
# newest PyPI release at build time so a template never bakes a stale
# runtime; set GNOSISLAB_VER to a version to pin (required offline).
GNOSISLAB_VER="${GNOSISLAB_VER:-latest}"
ISO="${LABLOOP_ISO:-}"
VIRSH="virsh -c qemu:///system"
WORK="$(mktemp -d)"
trap 'report_phases; rm -rf "$WORK"; [ -z "${CACHE_HTTP_PID:-}" ] || kill "$CACHE_HTTP_PID" 2>/dev/null; [ "${CACHE_RULE_ADDED:-0}" = 1 ] && sudo -n ufw delete allow in on virbr0 to 192.168.122.1 port 8777 proto tcp comment labloop-cache >/dev/null 2>&1; true' EXIT

die()  { echo "create-lab-template: $*" >&2; exit 1; }
# "latest" → newest PyPI release. TTL=0 for this package: prefetch
# re-pulls it on every online run so a fresh VM never ships a stale
# trusted-zone runtime.
if [ "$GNOSISLAB_VER" = latest ]; then
    GNOSISLAB_VER=$(curl -fsSL https://pypi.org/pypi/gnosislab/json \
        | grep -oE '"version": *"[^"]+"' | head -1 \
        | grep -oE '[0-9][0-9A-Za-z.-]*') \
        && [ -n "$GNOSISLAB_VER" ] \
        || die "cannot resolve latest gnosislab release — set GNOSISLAB_VER explicitly"
    echo "==> gnosislab: resolved latest -> $GNOSISLAB_VER"
fi
# phase timing — each note() call closes the previous phase; the EXIT
# trap prints the breakdown + total elapsed
T0=$SECONDS; _pt=$T0
PHASE_NAMES=() PHASE_SECS=()
note() {
    local now=$SECONDS
    ((${#PHASE_NAMES[@]})) && PHASE_SECS+=("$((now - _pt))")
    PHASE_NAMES+=("$*"); _pt=$now
    echo; echo "==> $*"
}
_fmt_dur() { printf '%dm%02ds' $(($1/60)) $(($1%60)); }
report_phases() {
    local now=$SECONDS i
    ((${#PHASE_NAMES[@]})) || return 0
    PHASE_SECS+=("$((now - _pt))")
    echo; echo "==> phases:"
    for i in "${!PHASE_NAMES[@]}"; do
        printf '    %-56s %7s\n' "${PHASE_NAMES[$i]}" "$(_fmt_dur "${PHASE_SECS[$i]}")"
    done
    printf '    %-56s %7s\n' TOTAL "$(_fmt_dur $((now - T0)))"
}

# VM sizing — labloop.conf (repo root); same-named env vars win.
# vcpus are clamped to 75% of host cores: a lab VM must never be
# sized to starve the host it runs on.
if [ -f "$REPO/labloop.conf" ]; then . "$REPO/labloop.conf"; fi
VCPUS="${LABLOOP_VCPUS:-16}"
MEM_MIB="${LABLOOP_MEMORY_MIB:-16384}"
RES_X="${LABLOOP_RES_X:-2560}"
RES_Y="${LABLOOP_RES_Y:-1440}"
REFRESH="${LABLOOP_REFRESH:-75}"
# refresh must be a number in [30,75] — 59.94-style decimals allowed.
# Out of range the EDID/modeline injection would produce nonsense.
if ! awk -v r="$REFRESH" 'BEGIN{
    exit !(r ~ /^[0-9]+(\.[0-9]+)?$/ && r+0 >= 30 && r+0 <= 75)}'; then
    die "LABLOOP_REFRESH=$REFRESH invalid (need 30-75 Hz, decimals ok)"
fi
host_cores="$(nproc)"
vcpu_cap=$(( host_cores * 3 / 4 )); [ "$vcpu_cap" -lt 1 ] && vcpu_cap=1
if [ "$VCPUS" -gt "$vcpu_cap" ]; then
    note "vcpus clamped: $VCPUS -> $vcpu_cap (75% of $host_cores host cores)"
    VCPUS=$vcpu_cap
fi
# guest RAM vs host MemAvailable: QEMU is the kernel's favourite OOM
# victim — a guest whose nominal size doesn't fit available host memory
# gets killed mid-install and leaves a partitioned-but-empty disk that
# boots to the UEFI shell. Refuse early; LABLOOP_MEM_OVERCOMMIT=1
# overrides for hosts with serious swap.
mem_avail_mib=$(awk '/^MemAvailable:/ {print int($2/1024)}' /proc/meminfo)
if [ "${LABLOOP_MEM_OVERCOMMIT:-0}" != "1" ] \
    && [ "$mem_avail_mib" -lt "$MEM_MIB" ]; then
    die "guest needs ${MEM_MIB}MiB but host MemAvailable is ${mem_avail_mib}MiB —
  the OOM killer will eat qemu mid-install.
  Free memory, add swap, or rerun with a smaller LABLOOP_MEMORY_MIB
  (or LABLOOP_MEM_OVERCOMMIT=1 if you really mean it)."
fi
# hostile-zone ceiling — derived: ~5/8 of guest vcpus, ~3/4 of guest
# RAM. The driver zone + desktop always keep headroom under a
# hostile-zone CPU/memory storm (observed: 8vcpu VM, exp at --cpus 6
# + --memory 16g, thread storm froze the whole guest).
EXP_CPUS=$(( VCPUS * 5 / 8 )); [ "$EXP_CPUS" -lt 1 ] && EXP_CPUS=1
EXP_MEM_MIB=$(( MEM_MIB * 3 / 4 ))

# ------------------------------------------------------------------
# Phase 0 — preflight
# ------------------------------------------------------------------
id -nG | grep -qw libvirt || exec sg libvirt -c "$0 $*"
$VIRSH list >/dev/null 2>&1 || die "cannot reach qemu:///system"
[ -e /dev/kvm ] || die "/dev/kvm missing (vboxdrv holding SVM? see protocol)"
command -v python3 >/dev/null || die "python3 required on host"

# ---- artifact cache (warmed by 00 -> selfbuild/prefetch-cache.sh) ----
# Every consume path below prefers the cache endpoint when its server
# is up and falls back to today's network path when it isn't — the
# cache is additive, never required for an online build. In
# LABLOOP_OFFLINE=1 it IS required: verify hard-fails on gaps and a
# dead endpoint means the guest cannot fetch at all.
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/labloop"
CACHE_URL="${LABLOOP_CACHE_URL:-http://192.168.122.1:8777}"
CACHE_HTTP_PID=""
# "up" must mean OUR cache: an answer alone is not enough — a stale or
# foreign http.server on :8777 answers the probe fine, then can die
# mid-provisioning and leave guest curls hung for minutes. Compare the
# served MANIFEST byte-for-byte with the local one.
cache_serving() {
    [ -f "$CACHE_ROOT/MANIFEST" ] \
        && curl -fs -m 3 "$CACHE_URL/MANIFEST" 2>/dev/null \
           | cmp -s - "$CACHE_ROOT/MANIFEST"
}
CACHE_UP=0
if ! cache_serving && [ -f "$CACHE_ROOT/MANIFEST" ]; then
    # down, or a foreign responder on the port. When we run under 00 its
    # server is already up; standalone (or after a mid-run death) we
    # bring up our own — killed by the EXIT trap above. A bare TCP
    # connect tells "listening but not ours" from "nothing there" —
    # independent of whether the foreign server has a /MANIFEST to 404.
    if (exec 3<>"/dev/tcp/192.168.122.1/8777") 2>/dev/null; then
        die "port 8777 is in use but does not serve the labloop cache — kill the foreign listener and retry"
    fi
    python3 -m http.server 8777 --bind 192.168.122.1 -d "$CACHE_ROOT" \
        >/dev/null 2>&1 &
    CACHE_HTTP_PID=$!
    sleep 0.5
    cache_serving || die "cache endpoint did not come up on $CACHE_URL"
    note "cache endpoint started: $CACHE_URL (pid $CACHE_HTTP_PID)"
fi
cache_serving && CACHE_UP=1
# The endpoint answering US is not enough: ufw default-denies inbound
# on virbr0, and libvirt opens INPUT holes only for its own services
# (dnsmasq 53/67) — so a listening server is still unreachable from the
# guest (connect TIMEOUT, not refused). This holds for our server AND
# for a reused/orphaned one, so check ufw whenever CACHE_UP=1. Without
# sudo we degrade to the plain network path; offline mode still dies
# at the gate below.
if [ "$CACHE_UP" = 1 ] && systemctl is-active --quiet ufw 2>/dev/null; then
    if sudo ufw allow in on virbr0 to 192.168.122.1 port 8777 proto tcp \
            comment 'labloop-cache' >/dev/null; then
        CACHE_RULE_ADDED=1
    else
        echo "    warn: ufw is active and no sudo — guests cannot reach" >&2
        echo "    the cache; falling back to the network path" >&2
        [ -n "$CACHE_HTTP_PID" ] && kill "$CACHE_HTTP_PID" 2>/dev/null
        CACHE_HTTP_PID=""; CACHE_UP=0
    fi
fi
if [ "${LABLOOP_OFFLINE:-0}" = "1" ]; then
    "$REPO/selfbuild/prefetch-cache.sh" --verify \
        || die "offline build requested but the artifact cache is incomplete"
    [ "$CACHE_UP" = 1 ] || die "offline build needs the cache endpoint \
(start the build via ./00-build-lab-template.sh, or serve $CACHE_ROOT \
on 192.168.122.1:8777 yourself)"
fi
# apt prelude: inject the flat cache source + refresh ONLY its lists
# (a full update would reintroduce the mirror dependency). Harmless
# when the endpoint is down — the install falls through to mirrors.
APT_PRELUDE=""
if [ "$CACHE_UP" = 1 ]; then
    note "artifact cache: $CACHE_URL (prefetched artifacts in use)"
    APT_PRELUDE="printf 'deb [trusted=yes] $CACHE_URL/apt ./\n' > /etc/apt/sources.list.d/labloop-cache.list && \
apt-get update -o Dir::Etc::SourceList='sources.list.d/labloop-cache.list' \
    -o Dir::Etc::SourceParts='-' -o APT::Get::List-Cleanup='0' -qq || true ; "
fi

# ------------------------------------------------------------------
# qemu guest-agent driver (inlined; exec + chunked file push)
# ------------------------------------------------------------------
# Shared QGA helper: persistent results and bounded transport recovery.
# No temporary host-side implementation that vanishes during a retry.
QGA_DRIVER="$REPO/scripts/qga.py"
[ -f "$QGA_DRIVER" ] || die "missing QGA driver: $QGA_DRIVER"

qga()      { python3 "$QGA_DRIVER" "$VM" exec "$@"; }
qga_lab()  { python3 "$QGA_DRIVER" "$VM" exec --as lab "$@"; }
qga_push() { python3 "$QGA_DRIVER" "$VM" push "$1" "$2"; }

agent_ready() {
    python3 "$QGA_DRIVER" "$VM" ping >/dev/null 2>&1 || return 1
    # The Mint live/installer session also runs qemu-guest-agent and
    # answers pings — only the INSTALLED system has the 'lab' user.
    qga "id lab >/dev/null 2>&1" 2>/dev/null
}

# ------------------------------------------------------------------
# Phase 1 — create the domain (skipped if it already exists)
# ------------------------------------------------------------------
if $VIRSH dominfo "$VM" >/dev/null 2>&1; then
    note "domain $VM exists — skipping virt-install"
else
    [ -n "$ISO" ] || die "LABLOOP_ISO=<mint.iso> required to create $VM"
    # qemu:///system runs guests as libvirt-qemu — the ISO must be
    # readable by THAT account: read on the file plus search on every
    # ancestor dir. A $HOME ISO (home is typically 0700/0750) fails at
    # monitor-connect with a cryptic blockdev EACCES; check traversal
    # up front and spell out the fix.
    qemu_user="$(getent passwd libvirt-qemu | cut -d: -f1)"
    qemu_user="${qemu_user:-qemu}"
    _perm_for() {  # $1=path $2=r|x — does qemu_user have it?
        local mode owner group obit gbit otbit
        read -r mode owner group < <(stat -c '%a %U %G' "$1") \
            || return 1
        if [ "$2" = x ]; then obit=64; gbit=8; otbit=1
        else                 obit=256; gbit=32; otbit=4; fi
        [ "$owner" = "$qemu_user" ] && \
            [ $((8#$mode & obit)) -ne 0 ] && return 0
        id "$qemu_user" 2>/dev/null | grep -qw "$group" && \
            [ $((8#$mode & gbit)) -ne 0 ] && return 0
        [ $((8#$mode & otbit)) -ne 0 ] && return 0
        getfacl -p "$1" 2>/dev/null | \
            grep -q "user:${qemu_user}:.*$2" && return 0
        return 1
    }
    iso_readable() {
        if sudo -n -u "$qemu_user" true 2>/dev/null; then
            sudo -n -u "$qemu_user" test -r "$1"; return
        fi
        local p
        p="$(readlink -f "$1")" || return 1
        while [ "$p" != "/" ]; do
            if [ -d "$p" ]; then _perm_for "$p" x || return 1
            else                 _perm_for "$p" r || return 1; fi
            p="$(dirname "$p")"
        done
    }
    if ! iso_readable "$ISO"; then
        # Stage a second dentry under libvirt's storage: a hardlink shares
        # the inode (no copy) and QEMU only traverses the NEW path — a
        # symlink would not help, the target's ancestors still gate access.
        # install(1) fallback covers cross-filesystem homes (EXDEV).
        staged="/var/lib/libvirt/images/labloop-iso/$(basename "$ISO")"
        note "ISO not readable by '$qemu_user' — staging into libvirt storage"
        if sudo mkdir -p "${staged%/*}" \
            && { sudo ln -f "$ISO" "$staged" 2>/dev/null \
                 || sudo install -m 0644 "$ISO" "$staged"; } \
            && iso_readable "$staged"; then
            ISO="$staged"
            note "staged: $ISO"
        else
            die "ISO not readable by '$qemu_user' and auto-stage failed.

  stage it yourself (no ACLs on your home needed):
      sudo mkdir -p /var/lib/libvirt/images/labloop-iso
      sudo cp \"$ISO\" /var/lib/libvirt/images/labloop-iso/
      LABLOOP_ISO=/var/lib/libvirt/images/labloop-iso/$(basename "$ISO") $0 $VM
  or grant search + read via ACL:
      p=\"$ISO\"; while [ \"\$p\" != / ]; do
          sudo setfacl -m u:$qemu_user:x \"\$p\"; p=\$(dirname \"\$p\")
      done
      sudo setfacl -m u:$qemu_user:r \"$ISO\""
        fi
    fi
    note "virt-install: $VM (${MEM_MIB}MiB / ${VCPUS}vcpu / 80G qcow2 / UEFI / SPICE)"
    virt-install --connect qemu:///system --name "$VM" \
        --memory "$MEM_MIB" --vcpus "$VCPUS" \
        --disk size=80,format=qcow2,bus=virtio \
        --cdrom "$ISO" \
        --os-variant generic \
        --network network=default,model=virtio \
        --graphics spice,listen=127.0.0.1 \
        --video virtio \
        --channel unix,target.type=virtio,target.name=org.qemu.guest_agent.0 \
        --boot uefi --noautoconsole
    # virt-install's emitted boot order is version-dependent: some builds
    # write only <boot dev='hd'/> under firmware='efi', which drops a fresh
    # domain into the UEFI shell (blank disk). Pin cdrom-first ordering;
    # <os> can't change on a live domain, so a define alone isn't enough —
    # destroy+start re-runs OVMF on the fixed XML (seconds into boot, safe).
    $VIRSH dumpxml "$VM" > "$WORK/dom-boot.xml"
    if ! grep -q "<boot dev='cdrom'/>" "$WORK/dom-boot.xml"; then
        if grep -q "<boot dev='hd'/>" "$WORK/dom-boot.xml"; then
            sed -i "s|<boot dev='hd'/>|<boot dev='cdrom'/>\n    <boot dev='hd'/>|" \
                "$WORK/dom-boot.xml"
        else  # no <boot dev> at all — OVMF-managed order; pin both
            sed -i "s|</os>|    <boot dev='cdrom'/>\n    <boot dev='hd'/>\n  </os>|" \
                "$WORK/dom-boot.xml"
        fi
        $VIRSH define "$WORK/dom-boot.xml" >/dev/null
        note "boot order lacked cdrom — restarting domain on fixed XML"
        $VIRSH destroy "$VM" 2>/dev/null || true
        $VIRSH start "$VM" >/dev/null
    fi
    if [[ "$ISO" == *auto* ]]; then
    cat <<EOF

  *** UNATTENDED INSTALL *** — automatic-ubiquity ISO detected.
  No interaction needed: partitioning, user 'lab', UTC timezone,
  qemu-guest-agent, and reboot are all preseeded. The script
  continues automatically when the installed agent comes up.
EOF
    else
    cat <<EOF

  *** MANUAL STEP ***
  Open virt-manager -> $VM -> complete the Mint install.
  (The GRUB menu waits for Enter — press it in the console;
   the black screen after that is the live session loading, ~40s.)
  Create the desktop user as:  lab
  When the installed system boots, run inside the guest:

      sudo apt update && sudo apt install -y qemu-guest-agent

  This script polls the guest agent and continues automatically.
EOF
    fi
fi

# An unattended install can POWER OFF instead of rebooting, and a
# resumed scratch build may also find the domain stopped. Eject the
# install medium (so a restart can't boot back into the installer)
# and power on the installed system.
eject_cdrom() {
    local t
    t="$($VIRSH domblklist "$VM" 2>/dev/null | awk '$2 ~ /\.iso/ {print $1; exit}')"
    [ -n "$t" ] || return 0
    $VIRSH change-media "$VM" "$t" --eject --live --config >/dev/null 2>&1 \
        || $VIRSH change-media "$VM" "$t" --eject --config >/dev/null 2>&1 \
        || true
}

fix_esp_offline() {
    # ubiquity under automatic mode can leave no usable boot entry — no
    # nvram 'ubuntu' AND no \EFI\BOOT\BOOTX64.EFI fallback — so the
    # installed system lands in the UEFI shell and the agent never comes
    # up. Write the fallback loader while the domain is offline (the
    # provisioning-time grub-install further down re-asserts it). Domain
    # MUST be shut off when this runs — virt-customize refuses a live one.
    if ! command -v virt-customize >/dev/null; then
        echo "    WARN: virt-customize (libguestfs-tools) missing — cannot" >&2
        echo "          write the UEFI fallback. If the guest lands at a" >&2
        echo "          'Shell>' prompt: FS0: then \\EFI\\ubuntu\\grubx64.efi" >&2
        return 0
    fi
    note "ESP fallback loader (offline, virt-customize)"
    if ! sudo virt-customize --no-network -d "$VM" --run-command '
            grub-install --target=x86_64-efi --efi-directory=/boot/efi \
                --removable --no-nvram \
            || { mkdir -p /boot/efi/EFI/BOOT
                 cp /boot/efi/EFI/ubuntu/shimx64.efi \
                    /boot/efi/EFI/BOOT/BOOTX64.EFI 2>/dev/null \
                 || cp /boot/efi/EFI/ubuntu/grubx64.efi \
                    /boot/efi/EFI/BOOT/BOOTX64.EFI
                 cp /boot/efi/EFI/ubuntu/grubx64.efi \
                    /boot/efi/EFI/BOOT/grubx64.efi
                 cp /boot/efi/EFI/ubuntu/grub.cfg \
                    /boot/efi/EFI/BOOT/grub.cfg; }'; then
        echo "    WARN: ESP fallback write failed — if the guest lands at" >&2
        echo "          a 'Shell>' prompt: FS0: then \\EFI\\ubuntu\\grubx64.efi" >&2
    fi
}

note "waiting for qemu-guest-agent in $VM"
echo "    (finish the Mint install, reboot, then install qemu-guest-agent)"
w=0
until agent_ready; do
    if [ "$($VIRSH domstate "$VM" 2>/dev/null)" = "shut off" ]; then
        eject_cdrom
        fix_esp_offline
        echo "    guest powered off — starting installed system (cdrom ejected)"
        $VIRSH start "$VM" >/dev/null
    fi
    w=$((w+1)); [ $((w % 12)) -eq 0 ] && echo "    ... still waiting ($((w*5))s)"
    sleep 5
done
echo "    agent responding (installed system)"

# QGA can be usable before the guest receives an IPv4 default route.
# The host cache check above proves host-local availability only; wait
# for actual guest-to-cache connectivity before doing any apt/OCI fetch.
if [ "$CACHE_UP" = 1 ]; then
    note "checking guest reachability of artifact cache"
    guest_cache_ok=0
    for _ in $(seq 1 24); do
        if qga "curl -fsS --connect-timeout 3 --max-time 8 '$CACHE_URL/MANIFEST' >/dev/null" \
                >/dev/null 2>&1; then
            guest_cache_ok=1
            break
        fi
        sleep 5
    done
    [ "$guest_cache_ok" = 1 ] || die "cache reachable on host, but not inside $VM.
  Diagnose guest IPv4 address/default route, libvirt default NAT network,
  and host firewall on virbr0 before resuming. No guest image rebuild needed."
fi

# ------------------------------------------------------------------
# Phase 2 — provision the guest (all via guest-agent, as needed user)
# ------------------------------------------------------------------
note "base packages"
# GUEST_PKGS: this list is single-sourced in selfbuild/prefetch-cache.sh
# (the prefetcher resolves its closure into the apt bundle). Add a
# package here without adding it there and it silently falls back to
# the mirror — fine online, dead in an offline build.
python3 "$QGA_DRIVER" "$VM" exec --resume base-packages "${APT_PRELUDE}DEBIAN_FRONTEND=noninteractive apt-get install -y \
     podman uidmap acl pipx python-is-python3 git curl qemu-guest-agent \
     spice-vdagent mc nodejs npm nftables"
# casper is the live-ISO bootstrapper left over by the unattended
# install — its md5check unit fails every boot (no md5sum.txt on an
# installed disk) and serves no purpose post-install. Purge it.
qga "DEBIAN_FRONTEND=noninteractive apt-get purge -y casper || true"
# password policy: length floor only — pam_unix minlen=3, no quality
# checks (pam_pwquality has a hardcoded floor of 6; use_authtok must go
# too — it expects a token from the quality module and fails without it);
# faillock below is the real defense against guessing
qga "sed -i '/^password.*pam_unix\.so/ c password\t[success=1 default=ignore]\tpam_unix.so minlen=3 yescrypt' \
     /etc/pam.d/common-password"

# The ISO preseed does not guarantee the installed account password when a
# resumed/manual install was used. Make the local-only default explicit.
# Published images are locked separately by LABLOOP_PUBLISH.
if [ "${LABLOOP_PUBLISH:-0}" != "1" ]; then
    note "local template credentials: lab/lab"
    qga "echo 'lab:lab' | chpasswd && passwd -S lab | grep -q ' P ' && \
         faillock --user lab --reset" || die "failed to initialize lab/lab"
fi

note "faillock: lock lab after 10 failed logins for 15 min"
qga "printf 'deny = 10\nfail_interval = 900\nunlock_time = 900\n' > /etc/security/faillock.conf"
qga "grep -q 'pam_faillock.so preauth' /etc/pam.d/common-auth || \
     sed -i 's|^\(auth.*pam_unix\.so.*\)|auth required pam_faillock.so preauth silent\n\1\nauth [default=die] pam_faillock.so authfail\nauth sufficient pam_faillock.so authsucc|' /etc/pam.d/common-auth"
qga "grep -q 'pam_faillock' /etc/pam.d/common-account || \
     sed -i '1i account required pam_faillock.so' /etc/pam.d/common-account"
# our edits make common-* "locally modified" — the first libpam-runtime
# update then asks 'Override local changes?' interactively and stalls
# Mint's Update Manager. Preseed the answer: keep local changes.
qga "echo 'libpam-runtime libpam-runtime/override boolean false' | debconf-set-selections"

note "users: exp + mcp + linger, subuid/subgid"
# mcp: dedicated service account for the TRUSTED zone — its podman runs
# lab-cnt-mcp and owns mcp-state, so the lab shell (and therefore the
# driving agent) cannot read, exec into, or kill the scientific state.
qga "id exp >/dev/null 2>&1 || useradd -m -s /bin/bash exp"
qga "id mcp >/dev/null 2>&1 || useradd -m -s /bin/bash mcp"
qga "loginctl enable-linger lab exp mcp"
qga "grep -q '^lab:' /etc/subuid || echo 'lab:100000:65536' >> /etc/subuid; \
     grep -q '^exp:' /etc/subuid || echo 'exp:165536:65536' >> /etc/subuid; \
     grep -q '^mcp:' /etc/subuid || echo 'mcp:231072:65536' >> /etc/subuid; \
     grep -q '^lab:' /etc/subgid || echo 'lab:100000:65536' >> /etc/subgid; \
     grep -q '^exp:' /etc/subgid || echo 'exp:165536:65536' >> /etc/subgid; \
