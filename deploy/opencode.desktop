[Desktop Entry]
Version=1.0
Type=Application
Name=OpenCode
Comment=AI coding agent in the GnosisLab driver workspace
# Use the XFCE terminal explicitly. --hold exposes launch failures rather
# than closing immediately when the CLI exits.
Exec=xfce4-terminal --hold --title=OpenCode --execute /usr/local/bin/opencode-lab
Icon=/home/lab/.local/share/icons/opencode.png
Path=/home/lab/workspace
Terminal=false
Categories=Development;
StartupNotify=false
