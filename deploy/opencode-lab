#!/usr/bin/env bash
# Start OpenCode inside the driver workspace, never under root.
set -e
if [ "$(id -u)" = 0 ]; then
    echo "OpenCode must run as lab, not root" >&2
    exit 1
fi
# Safe local repair for old clones: creating the lab-owned authoring
# directory must not depend on the trusted MCP image being healthy.
if [ -L /home/lab/workspace ]; then
    echo "Refusing symlinked driver workspace" >&2
    exit 1
fi
if ! mkdir -p /home/lab/workspace/experiments ||
   ! cd /home/lab/workspace; then
    echo "Cannot create or enter /home/lab/workspace" >&2
    exit 1
fi
if ! command -v opencode >/dev/null 2>&1; then
    echo "OpenCode CLI not installed or not on PATH." >&2
    echo "Check: command -v opencode; ls -l /usr/local/bin/opencode" >&2
    exit 127
fi
exec opencode "$@"
